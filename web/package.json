{
  "name": "shopify-app-template-node",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "debug": "node --inspect-brk --loader tsx index.ts",
    "dev": "cross-env NODE_ENV=development tsx watch index.ts --ignore ./frontend",
    "serve": "cross-env NODE_ENV=production tsx index.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit --watch"
  },
  "type": "module",
  "engines": {
    "node": ">=14.13.1"
  },
  "dependencies": {
    "@shopify/shopify-api": "^12.2.0",
    "@shopify/shopify-app-express": "^6.0.4",
    "@shopify/shopify-app-session-storage-sqlite": "^1.2.2",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "serve-static": "^1.14.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^8.10.66",
    "@types/serve-static": "^2.2.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
